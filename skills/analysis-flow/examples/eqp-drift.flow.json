{
  "kind": "swimlane",
  "id": "eqp-drift-lane",
  "title": "EQP01 센서 이탈 분석",
  "caption": "EQP01 센서 이탈 분석 과정. DB 두 표와 수집 로그에서 데이터를 얻고, 이탈 건수를 세어 5건을 넘으면 셋업 이벤트를 더 본다. 번호는 아래 부록의 쿼리 · 명령 전문과 짝이다.",
  "lanes": [
    { "id": "db", "label": "DB" },
    { "id": "log", "label": "서버 로그" },
    { "id": "calc", "label": "계산/판단" },
    { "id": "result", "label": "결과" }
  ],
  "steps": [
    {
      "id": "s1",
      "lane": "db",
      "text": "1. 센서 목록",
      "sub": "SELECT sensor_id, sensor_name, unit FROM…",
      "code": true
    },
    {
      "id": "s2",
      "lane": "db",
      "text": "2. 센서 통계 조회",
      "sub": "SELECT sensor_id, ts, mean_val, ucl, lcl",
      "code": true
    },
    {
      "id": "s3",
      "lane": "log",
      "text": "3. 수집 오류 확인",
      "sub": "rg -n 'EQP01.*(ERROR|timeout)' /var/log/…",
      "code": true
    },
    {
      "id": "s4",
      "lane": "calc",
      "text": "4. 이탈 건수 · 평균 비교",
      "sub": "mean_val > ucl 또는 mean_val < lcl 인 행 수,",
      "code": true
    },
    {
      "id": "s5",
      "lane": "calc",
      "kind": "gate",
      "text": "5. 이탈 많은가",
      "sub": "이탈 > 5",
      "code": true
    },
    {
      "id": "s6",
      "lane": "db",
      "text": "6. 셋업 이벤트 조회",
      "sub": "SELECT event_id, ts, event_type, operato…",
      "code": true
    },
    {
      "id": "s7",
      "lane": "result",
      "kind": "io",
      "text": "7. 결과 정리",
      "sub": "PM 교체 뒤 센서 3개 평균 이동"
    }
  ],
  "flows": [
    { "from": "s1", "to": "s2" },
    { "from": "s2", "to": "s3" },
    { "from": "s3", "to": "s4" },
    { "from": "s4", "to": "s5" },
    { "from": "s5", "to": "s6", "kind": "cond", "label": "이탈 > 5" },
    { "from": "s5", "to": "s7", "kind": "cond", "label": "이탈 ≤ 5" },
    { "from": "s6", "to": "s7" }
  ]
}
